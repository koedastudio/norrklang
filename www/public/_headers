# Served by Cloudflare Workers static assets.
# `default-src 'none'` with `script-src 'self'`: the only scripts are the
# /report and /songs decoders, bundled as files (see astro.config.mjs). If a
# page ever needs more, loosen this deliberately — do not delete it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'none'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
