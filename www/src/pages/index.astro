---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { GITHUB_URL, LICENSE_URL, PLAY_URL, PUBLISHER, PUBLISHER_URL, TAGLINE } from '../config';
import carDashboard from '../assets/car-dashboard.png';
import screenHome from '../assets/screen-home.webp';
import screenPlayer from '../assets/screen-player.webp';
import screenLibrary from '../assets/screen-library.webp';

const features = [
  {
    title: 'Home screen',
    body: 'Quick play, favourite artists, recently added tracks, the radio stations you play most, and mixes made from your own library — Best of, Similar to, genres and decades.',
    icon: 'home',
  },
  {
    title: 'Library',
    body: 'Artists, albums, playlists, favourites and your server’s internet radio stations, with long lists split into alphabetical sections so they’re quick to scroll.',
    icon: 'library',
  },
  {
    title: 'Playback',
    body: 'Play, shuffle, seek, queue and heart the current track — on radio, the heart saves the song for later. Picks up where you left off after the car restarts, and adds similar songs when the queue runs out.',
    icon: 'play',
  },
  {
    title: 'Search and assistant',
    body: 'Type it or say it — search artists, albums and tracks. Or ask the car’s assistant to play an artist, album, song or playlist.',
    icon: 'search',
  },
  {
    title: 'Streaming quality',
    body: 'Original files on Wi-Fi, a capped bitrate on mobile data — or pick your own tiers for each connection in the settings.',
    icon: 'wifi',
  },
  {
    title: 'Scrobbling',
    body: 'Play counts go to your own server, not a third party. Exclude artists, playlists or whole libraries, or turn it off in the settings.',
    icon: 'equalizer',
  },
];

const requirements = [
  {
    n: '01',
    title: 'A Navidrome, Plex or Jellyfin server',
    body: 'Norrklang plays music from your own server. It’s built and tested against Navidrome, works with other servers that speak the Subsonic API, connects to a Plex Media Server by linking your Plex account, and signs in to Jellyfin with your server address and account. If the server has several music libraries, you pick which ones to show.',
  },
  {
    n: '02',
    title: 'A car running Android Automotive OS',
    body: 'The kind of car with Google Play built into the dashboard — Polestar, Volvo, Renault, Chevrolet, Honda and a growing list of others. The app runs in the car itself, not from your phone.',
  },
  {
    n: '03',
    title: 'A secure connection',
    body: 'Your Navidrome or Jellyfin server needs to be reachable over HTTPS. If you already reach it from outside your home network, you’re most likely all set. Plex connections use Plex’s own secure addresses, so there’s nothing extra to set up. Internet radio stations play from whatever address your server lists for them, plain http included.',
  },
];

/*
 * Material Symbols, Outlined, weight 300, 24px (Apache 2.0) — the same set and
 * cut the app draws its tab and tile icons from (android/core-media/.../res/
 * drawable/ic_browse_*.xml, ic_home_*.xml); home and library_music are the
 * app's own path data verbatim. Glyphs are on the symbols' 0 -960 960 960
 * grid; fill1 variants where the app uses filled icons.
 */
const iconPaths: Record<string, string> = {
  home: 'M180-140v-450l300-225.77L780-590v450H556.15v-267.69h-152.3V-140H180Z',
  library:
    'M493.85-366.15q37.76 0 63.88-26.12 26.11-26.11 26.11-63.88v-224.62h114.62v-70.77h-150v226.16q-11.46-10.39-25.11-15.58-13.66-5.19-29.5-5.19-37.77 0-63.89 26.11-26.11 26.12-26.11 63.89 0 37.77 26.11 63.88 26.12 26.12 63.89 26.12ZM322.31-260Q292-260 271-281q-21-21-21-51.31v-455.38Q250-818 271-839q21-21 51.31-21h455.38Q808-860 829-839q21 21 21 51.31v455.38Q850-302 829-281q-21 21-51.31 21H322.31Zm-140 140Q152-120 131-141q-21-21-21-51.31v-515.38h60v515.38q0 4.62 3.85 8.46 3.84 3.85 8.46 3.85h515.38v60H182.31Z',
  play: 'M340-236.16v-487.68L723.07-480 340-236.16Z',
  search:
    'M781.69-136.92 530.46-388.16q-30 24.77-69 38.77-39 14-80.69 14-102.55 0-173.58-71.01-71.03-71.01-71.03-173.54 0-102.52 71.01-173.6 71.01-71.07 173.54-71.07 102.52 0 173.6 71.03 71.07 71.03 71.07 173.58 0 42.85-14.38 81.85-14.39 39-38.39 67.84l251.23 251.23-42.15 42.16ZM380.77-395.38q77.31 0 130.96-53.66 53.66-53.65 53.66-130.96t-53.66-130.96q-53.65-53.66-130.96-53.66t-130.96 53.66Q196.15-657.31 196.15-580t53.66 130.96q53.65 53.66 130.96 53.66Z',
  wifi: 'M480-131.54q-33.92 0-57.35-23.42-23.42-23.42-23.42-57.35 0-33.92 23.42-57.34 23.43-23.42 57.35-23.42t57.35 23.42q23.42 23.42 23.42 57.34 0 33.93-23.42 57.35-23.43 23.42-57.35 23.42ZM254-346l-62.46-63.69q55.54-55.54 129.33-87.54 73.8-32 159.19-32 85.4 0 159.13 32.31 73.73 32.31 129.27 88.46L706-346q-44-44-102-69t-124-25q-66 0-124 25t-102 69ZM84-516l-62.46-62.46q87.77-89 205-139.88Q343.77-769.23 480-769.23q136.23 0 253.46 50.89 117.23 50.88 205 139.88L876-516q-77-77-178.5-120.5T480-680q-116 0-217.5 43.5T84-516Z',
  equalizer: 'M180-180v-276.15h140V-180H180Zm230 0v-600h140v600H410Zm230 0v-403.84h140V-180H640Z',
};
---

<Base>
  <section class="hero">
    <div class="hero__aurora" aria-hidden="true"></div>
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="pill">Android Automotive OS</p>
        <h1>{TAGLINE}</h1>
        <p class="hero__lede">
          Norrklang is a music player for <a href="https://www.navidrome.org/">Navidrome</a> and
          Subsonic-compatible servers, <a href="https://www.plex.tv/">Plex</a> and <a
            href="https://jellyfin.org/">Jellyfin</a>, made for cars running Android Automotive
          OS. It installs in the car itself — not on your phone — and plays your own music,
          straight from your server.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={PLAY_URL}>Get it on Google Play</a>
          <a class="btn btn--ghost" href={GITHUB_URL}>View the source</a>
        </div>
        <ul class="hero__facts" role="list">
          <li>Gapless playback</li>
          <li>No analytics, no third parties</li>
          <li>GPL-3.0 open source</li>
        </ul>
      </div>
      <figure class="hero__photo">
        {/* 1023 is the composite’s native width — the srcset can’t go larger. */}
        <Image
          src={carDashboard}
          alt="Norrklang’s album grid on the centre display of a Polestar 2, seen past the steering wheel"
          widths={[480, 720, 1023]}
          sizes="(max-width: 56rem) 92vw, 34rem"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>Norrklang in a Polestar 2</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="features">
    <div class="wrap">
      <p class="kicker">From the driver’s seat</p>
      <h2>What it does</h2>
      <ul class="features" role="list">
        {
          features.map((f) => (
            <li class="feature">
              <span class="feature__icon" aria-hidden="true">
                <svg viewBox="0 -960 960 960" fill="currentColor">
                  <path d={iconPaths[f.icon]} />
                </svg>
              </span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--band" id="screens">
    <div class="wrap">
      <p class="kicker">On the car’s screen</p>
      <h2>Feels at home in your car</h2>
      <p class="section__prose">
        Browse artists, albums, playlists and mixes with the controls your car already has.
        Norrklang follows Android Automotive’s media and safety conventions — down to the
        Material Symbols icons — so it looks and behaves like it came with the car.
      </p>
      <div class="screens">
        <figure class="screen">
          <Image
            src={screenHome}
            alt="Home screen in the car UI: Quick play tiles for Favourites, Recently added and Random mix, then Made for you mixes, with tabs for Home, Playlists and Library"
            widths={[400, 800]}
            sizes="(max-width: 56rem) 92vw, 30rem"
            loading="lazy"
          />
          <figcaption>Quick play and mixes made from your own library</figcaption>
        </figure>
        <figure class="screen">
          <Image
            src={screenPlayer}
            alt="Now Playing screen in the car UI: cover art, track title, artist, elapsed and total time, seek bar, and shuffle, skip, play and heart controls"
            widths={[400, 800]}
            sizes="(max-width: 56rem) 92vw, 30rem"
            loading="lazy"
          />
          <figcaption>Full playback with seek, shuffle and favourites</figcaption>
        </figure>
        <figure class="screen">
          <Image
            src={screenLibrary}
            alt="Library tab in the car UI: Albums rows for Recently added, Recently played, Most played, Favourite albums and All albums, then Artists rows for Favourite artists and All artists"
            widths={[400, 800]}
            sizes="(max-width: 56rem) 92vw, 30rem"
            loading="lazy"
          />
          <figcaption>Library: albums, artists and favourites, a tap away</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="requirements">
    <div class="wrap">
      <p class="kicker">Getting started</p>
      <h2>What you need</h2>
      <ol class="reqs" role="list">
        {
          requirements.map((r) => (
            <li class="req">
              <span class="req__n" aria-hidden="true">{r.n}</span>
              <div>
                <h3>{r.title}</h3>
                <p>{r.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--band" id="open-source">
    <div class="wrap promise">
      <div class="promise__col">
        <p class="kicker">Private by design</p>
        <h2>Your listening stays between your car and your server</h2>
        <p class="section__prose">
          No accounts, no analytics, no ads. The app talks to your server and nothing else —
          apart from the radio stations you choose to play, which stream from their own servers.
          When you sign in, only an encrypted token is kept in the car; your password is stored,
          encrypted the same way, only for the few servers that can’t verify tokens.
        </p>
      </div>
      <div class="promise__col">
        <p class="kicker">Open source</p>
        <h2>Free, as in Navidrome</h2>
        <p class="section__prose">
          Norrklang is licensed under <a href={LICENSE_URL}>GPL-3.0-or-later</a> — the same license
          as Navidrome — and developed by <a href={PUBLISHER_URL}>{PUBLISHER}</a>. The app, this
          website and the release tooling are all <a href={GITHUB_URL}>on GitHub</a>. Bug reports
          and contributions are very welcome.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta">
        <div class="cta__mark" aria-hidden="true"><Mark size={56} /></div>
        <h2>Get Norrklang in your car</h2>
        <p>
          Open Google Play in your car and search for Norrklang, or install it remotely from the
          listing below — it’s free. Sign in to your server, and your library is right there on
          the dashboard.
        </p>
        <div class="cta__actions">
          <a class="btn btn--primary" href={PLAY_URL}>Get it on Google Play</a>
          <a class="btn btn--ghost" href={GITHUB_URL}>Star it on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- Hero ----------------------------------------------------------- */

  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border-soft);
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(3rem, 7vw, 6rem);
  }

  .hero__aurora {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 55% 45% at 18% 0%, rgba(79, 216, 196, 0.14), transparent 70%),
      radial-gradient(ellipse 45% 55% at 85% 20%, rgba(79, 216, 196, 0.07), transparent 70%);
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero h1 {
    /* The cap breaks the tagline into three tidy lines, “Your Navidrome”
       alone on the first; `pretty` overrides the global `balance`, which
       would rebreak the phrase mid-line. */
    font-size: clamp(2.25rem, 1.4rem + 3.2vw, 3.5rem);
    margin-top: 1.5rem;
    max-width: 13ch;
    text-wrap: pretty;
  }

  .hero__lede {
    color: var(--text-muted);
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    max-width: 44ch;
    margin-top: 1.5rem;
  }

  .hero__cta {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__facts {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .hero__facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero__facts li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .hero__photo {
    margin: 0;
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.55),
      0 0 120px rgba(79, 216, 196, 0.07);
  }

  .hero__photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__photo figcaption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 3.5rem 1.25rem 1rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--bg-deep) 85%, transparent),
      transparent
    );
  }

  @media (max-width: 56rem) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__photo {
      max-width: 30rem;
    }
  }

  /* --- Sections ------------------------------------------------------- */

  .section {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .section--band {
    background: var(--bg-deep);
    border-block: 1px solid var(--border-soft);
  }

  .kicker {
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }

  .section h2 {
    font-size: clamp(1.75rem, 1.3rem + 1.9vw, 2.75rem);
    max-width: 24ch;
  }

  .section__prose {
    color: var(--text-muted);
    max-width: 58ch;
    margin-top: 1.25rem;
  }

  /* --- Features ------------------------------------------------------- */

  .features {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }

  .feature {
    position: relative;
    background: linear-gradient(180deg, var(--surface-raised), var(--surface));
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    padding: 1.75rem 1.5rem 1.5rem;
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .feature:hover {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .feature,
    .feature:hover {
      transition: none;
      transform: none;
    }
  }

  .feature__icon {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--accent-dim);
    color: var(--accent-bright);
    margin-bottom: 1.1rem;
  }

  .feature__icon svg {
    width: 1.375rem;
    height: 1.375rem;
  }

  .feature h3 {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .feature p {
    margin: 0.6rem 0 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  /* --- Screens -------------------------------------------------------- */

  .screens {
    margin-top: 3rem;
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    align-items: start;
  }

  .screen {
    margin: 0;
  }

  .screen img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  .screen figcaption {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    text-align: center;
  }

  /* --- Requirements --------------------------------------------------- */

  .reqs {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--border-soft);
  }

  .req {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--border-soft);
  }

  .req__n {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.9375rem;
    padding-top: 0.2rem;
  }

  .req h3 {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }

  .req p {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    max-width: 62ch;
  }

  @media (max-width: 34rem) {
    .req {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }

  /* --- Privacy / open source ------------------------------------------ */

  .promise {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: clamp(2rem, 5vw, 4rem);
  }

  .promise__col h2 {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
  }

  /* --- Closing CTA ---------------------------------------------------- */

  .cta {
    position: relative;
    overflow: hidden;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 5vw, 3rem);
    background:
      radial-gradient(ellipse 70% 90% at 50% -20%, rgba(79, 216, 196, 0.16), transparent 70%),
      linear-gradient(180deg, var(--surface-raised), var(--bg-deep));
  }

  .cta__mark {
    line-height: 0;
    margin-bottom: 1.25rem;
  }

  .cta h2 {
    font-size: clamp(1.75rem, 1.3rem + 1.9vw, 2.5rem);
    margin-inline: auto;
  }

  .cta p {
    color: var(--text-muted);
    margin: 1rem 0 0;
  }

  .cta__actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
</style>
